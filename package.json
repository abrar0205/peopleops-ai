{
  "name": "peopleops-ai",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "People analytics on a real stack: PostgreSQL, Prisma, tRPC, React. Runs fully in the browser on PGlite.",
  "engines": { "node": ">=20" },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pipeline": "tsx server/pipeline-cli.ts",
    "server": "tsx server/index.ts",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.105.0",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "pg": "8.16.3",
    "pglite-prisma-adapter": "0.7.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.5"
  }
}
